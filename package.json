{
  "name": "farm-ledger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "start:render": "npm run db:deploy && npm run db:seed && npm run start",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:setup": "npm run db:deploy && npm run db:seed",
    "test:vercel": "node tests/vercel-deploy.mjs",
    "db:seed": "node prisma/seed.js",
    "test": "node --test tests/*.test.js",
    "test:api": "node tests/integration.mjs",
    "test:render": "node tests/render-deploy.mjs",
    "test:browser": "node tests/browser.mjs && node tests/workflow.mjs && node tests/routing.mjs",
    "format": "prettier --write app components lib tests prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "bcryptjs": "^3.0.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "prettier": "^3.9.7",
    "prisma": "6.19.2",
    "tailwindcss": "^4.1.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "uuid": "^11.1.1",
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0"
  }
}
